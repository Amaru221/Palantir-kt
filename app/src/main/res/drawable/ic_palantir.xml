<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Fondo circular negro AMOLED con degradado azul místico -->
    <path android:pathData="M54,54m-50,0a50,50 0 1,0 100,0a50,50 0 1,0 -100,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="50"
                android:type="radial">
                <item android:color="#0D1B2A" android:offset="0.0" />
                <item android:color="#000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Anillo orbital exterior futurista -->
    <path
        android:pathData="M 54,20 A 34,34 0 1,1 20,54"
        android:strokeWidth="2.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="20"
                android:startY="20"
                android:endX="88"
                android:endY="88"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Anillo orbital interior opuesto -->
    <path
        android:pathData="M 54,88 A 34,34 0 0,1 88,54"
        android:strokeWidth="2.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="20"
                android:startY="88"
                android:endX="88"
                android:endY="20"
                android:type="linear">
                <item android:color="#7C4DFF" android:offset="0.0" />
                <item android:color="#000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Resplandor / Glow del Orbe Central -->
    <path android:pathData="M54,54m-22,0a22,22 0 1,0 44,0a22,22 0 1,0 -44,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="22"
                android:type="radial">
                <item android:color="#8000E5FF" android:offset="0.0" />
                <item android:color="#0000E5FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Núcleo del Orbe Palantir -->
    <path android:pathData="M54,54m-14,0a14,14 0 1,0 28,0a14,14 0 1,0 -28,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="40"
                android:startY="40"
                android:endX="68"
                android:endY="68"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#2979FF" android:offset="0.5" />
                <item android:color="#651FFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Destello / Brillo especular superior del orbe -->
    <path
        android:pathData="M50,44a6,6 0 1,0 8,0a6,6 0 1,0 -8,0"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.6" />

</vector>